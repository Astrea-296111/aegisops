# aegisops init creates random tokens. Never commit .env.
AEGIS_DATABASE_URL=sqlite+aiosqlite:///./aegisops.db
AEGIS_SOURCE=replay
AEGIS_PROVIDER=fake
AEGIS_VIEWER_TOKEN=
AEGIS_OPERATOR_TOKEN=
AEGIS_DEMO_TOKEN=
AEGIS_DEMO_ONLY=false
# Optional: OpenAI-compatible Chat Completions endpoint supporting JSON mode
AEGIS_LLM_BASE_URL=https://api.openai.com/v1
AEGIS_LLM_MODEL=configure-your-model
AEGIS_LLM_API_KEY=
# Set per-million prices yourself; unset real-provider cost is NOT_MEASURED.
# AEGIS_INPUT_COST_PER_MILLION=
# AEGIS_OUTPUT_COST_PER_MILLION=

